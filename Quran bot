# ─── المعالجات ────────────────────────────────────────────────────────────────

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    text = (
        "السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ 🌿\n\n"
        "أهلاً بك في *بوت الأذكار والقرآن*\n\n"
        "اختر ما يُسعدك:"
    )
    if update.message:
        await update.message.reply_text(text, parse_mode="Markdown", reply_markup=main_menu_keyboard())
    elif update.callback_query:
        await update.callback_query.edit_message_text(text, parse_mode="Markdown", reply_markup=main_menu_keyboard())

async def button_handler(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data

    if data == "main":
        await query.edit_message_text("اختر ما يُسعدك:", reply_markup=main_menu_keyboard())

    elif data == "sabah":
        zikr = random.choice(ATHKAR_SABAH)
        await query.edit_message_text(f"🌅 *ذكر من أذكار الصباح*\n\n{zikr}", parse_mode="Markdown", reply_markup=back_keyboard())

    elif data == "masa":
        zikr = random.choice(ATHKAR_MASA)
        await query.edit_message_text(f"🌆 *ذكر من أذكار المساء*\n\n{zikr}", parse_mode="Markdown", reply_markup=back_keyboard())

    elif data == "nawm":
        zikr = random.choice(ATHKAR_NAWM)
        await query.edit_message_text(f"🌙 *ذكر من أذكار النوم*\n\n{zikr}", parse_mode="Markdown", reply_markup=back_keyboard())

    elif data == "general":
        zikr = random.choice(ADHKAR_GENERAL)
        await query.edit_message_text(f"📿 *ذكر*\n\n{zikr}", parse_mode="Markdown", reply_markup=back_keyboard())

    elif data == "ayah":
        item = random.choice(AYAT)
        await query.edit_message_text(
            f"📖 *آية من القرآن الكريم*\n\n{item['text']}\n\nسورة {item['surah']} — الآية {item['ayah']}",
            parse_mode="Markdown", reply_markup=back_keyboard()
        )

    elif data == "dua":
        await query.edit_message_text("🤲 *اختر دعاءً:*", parse_mode="Markdown", reply_markup=duas_keyboard())

    elif data == "dua_random":
        item = random.choice(DUAS)
        back = InlineKeyboardMarkup([
            [InlineKeyboardButton("🔙 رجوع للأدعية", callback_data="dua")],
            [InlineKeyboardButton("🏠 القائمة الرئيسية", callback_data="main")],
        ])
        await query.edit_message_text(f"🤲 *{item['title']}*\n\n{item['text']}", parse_mode="Markdown", reply_markup=back)

    elif data.startswith("dua_") and data != "dua_random":
        idx = int(data.split("_")[1])
        item = DUAS[idx]
        back = InlineKeyboardMarkup([
            [InlineKeyboardButton("🔙 رجوع للأدعية", callback_data="dua")],
            [InlineKeyboardButton("🏠 القائمة الرئيسية", callback_data="main")],
        ])
        await query.edit_message_text(f"🤲 *{item['title']}*\n\n{item['text']}", parse_mode="Markdown", reply_markup=back)

    elif data == "stories":
        await query.edit_message_text("📚 *القصص القرآنية*\n\nاختر قصة:", parse_mode="Markdown", reply_markup=stories_keyboard())

    elif data.startswith("story_"):
        idx = int(data.split("_")[1])
        story = QURANIC_STORIES[idx]
        back = InlineKeyboardMarkup([
            [InlineKeyboardButton("🔙 رجوع للقصص", callback_data="stories")],
            [InlineKeyboardButton("🏠 القائمة الرئيسية", callback_data="main")],
        ])
        await query.edit_message_text(f"*{story['title']}*\n\n{story['story']}", parse_mode="Markdown", reply_markup=back)

    elif data == "muharram":
        await query.edit_message_text("🌙 *شهر المحرم*\n\nاختر:", parse_mode="Markdown", reply_markup=muharram_keyboard())

    elif data == "muharram_info":
        back = InlineKeyboardMarkup([
            [InlineKeyboardButton("🔙 رجوع للمحرم", callback_data="muharram")],
            [InlineKeyboardButton("🏠 القائمة الرئيسية", callback_data="main")],
        ])
        await query.edit_message_text(MUHARRAM_INFO, parse_mode="Markdown", reply_markup=back)

    elif data == "ashura":
        back = InlineKeyboardMarkup([
            [InlineKeyboardButton("🔙 رجوع للمحرم", callback_data="muharram")],
            [InlineKeyboardButton("🏠 القائمة الرئيسية", callback_data="main")],
        ])
        await query.edit_message_text(ASHURA_INFO, parse_mode="Markdown", reply_markup=back)

# ─── التشغيل ──────────────────────────────────────────────────────────────────

def main():
    app = Application.builder().token(BOT_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("menu", start))
    app.add_handler(CallbackQueryHandler(button_handler))
    print("✅ البوت يعمل الآن...")
    app.run_polling(allowed_updates=Update.ALL_TYPES)

if __name__ == "__main__":
    main()
